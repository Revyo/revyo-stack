{
  "name": "@revyo/stack",
  "version": "0.1.1",
  "description": "Installable agent skills for building Revyo Software projects",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Revyo/revyo-stack.git"
  },
  "homepage": "https://github.com/Revyo/revyo-stack#readme",
  "bugs": {
    "url": "https://github.com/Revyo/revyo-stack/issues"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.12"
  },
  "packageManager": "bun@1.3.12",
  "bin": {
    "revyo-stack": "bin/revyo-stack.mjs",
    "revyo-crap": "skills/revyo-testing/scripts/crap.mjs"
  },
  "exports": {
    "./crap": "./skills/revyo-testing/scripts/crap.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node bin/revyo-stack.mjs postinstall",
    "test": "bun test tests",
    "test:coverage": "bun tests/run-coverage.mjs",
    "quality:crap": "bun run test:coverage && bun skills/revyo-testing/scripts/crap.mjs --config crap.config.json",
    "test:install": "bun scripts/smoke-install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun scripts/validate.mjs",
    "check": "bun run format:check && bun run validate && bun run quality:crap && bun run test:install",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "prettier": "3.9.9"
  }
}
